{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "../.desktop",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "incremental": false,
    "isolatedModules": false,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
