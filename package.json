{
  "name": "review-workspace",
  "productName": "错题复盘",
  "description": "本地优先的错题复盘与 AI 学习工作台",
  "author": "Private",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": ".desktop/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.8",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "nanoid": "3.3.18",
    "undici": "7.29.1",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "brace-expansion@1.1.15": "1.1.16",
    "brace-expansion@5.0.6": "5.0.8",
    "next": {
      "postcss": "8.5.23"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:compile": "node scripts/compile-desktop.mjs",
    "desktop:host": "node scripts/prepare-desktop-host.mjs",
    "desktop:dev": "concurrently -k -s first \"npm:dev\" \"npm:desktop:dev:electron\"",
    "desktop:dev:electron": "wait-on http://localhost:3000 && npm run desktop:compile && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron-forge start",
    "desktop:prepare": "npm run build && npm run desktop:compile && npm run desktop:host && node scripts/prepare-desktop-runtime.mjs && node scripts/prepare-electron-archive.mjs",
    "desktop:package": "npm run desktop:prepare && .\\.desktop-runtime\\node\\node.exe --require ./scripts/electron-packager-windows-resource-preload.cjs node_modules/@electron-forge/cli/dist/electron-forge-package.js --arch=x64 .desktop-app && npm run test:desktop:artifact",
    "desktop:make": "npm run desktop:prepare && .\\.desktop-runtime\\node\\node.exe --require ./scripts/electron-packager-windows-resource-preload.cjs node_modules/@electron-forge/cli/dist/electron-forge-make.js --arch=x64 .desktop-app && npm run test:desktop:artifact",
    "desktop:builder:m0:unpacked": "npm run desktop:prepare && .\\.desktop-runtime\\node\\node.exe node_modules/electron-builder/cli.js --projectDir .desktop-app --config ..\\electron-builder.m0.cjs --win --x64 --dir --publish never",
    "desktop:builder:m0": "npm run desktop:prepare && .\\.desktop-runtime\\node\\node.exe node_modules/electron-builder/cli.js --projectDir .desktop-app --config ..\\electron-builder.m0.cjs --win --x64 --publish never",
    "desktop:builder:nsis:unpacked": ".\\.desktop-runtime\\node\\node.exe node_modules/electron-builder/cli.js --projectDir .desktop-app --config ..\\electron-builder.nsis.cjs --win --x64 --dir --publish never",
    "desktop:builder:nsis:bundle": ".\\.desktop-runtime\\node\\node.exe node_modules/electron-builder/cli.js --projectDir .desktop-app --config ..\\electron-builder.nsis.cjs --win --x64 --publish never",
    "desktop:builder:nsis": "npm run desktop:prepare && npm run desktop:builder:nsis:unpacked && npm run desktop:builder:nsis:bundle",
    "typecheck": "tsc --noEmit",
    "audit:prod": "node scripts/audit-production.mjs",
    "analyze:bundle": "next experimental-analyze --output",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:contracts": "node --test --experimental-strip-types scripts/node-runtime.contract.test.mjs scripts/audit-production.contract.test.mjs scripts/recall-brand-assets.contract.test.mjs scripts/production-tuple.contract.test.mjs scripts/release-artifact-provenance.contract.test.mjs scripts/verify-draft-release-roundtrip.contract.test.mjs app/features/conversation/conversation-composer.contract.test.ts app/features/conversation/conversation-drag.contract.test.ts app/features/conversation/conversation-navigation.contract.test.ts app/features/conversation/conversation-message-utils.contract.test.ts app/features/performance/architecture-boundary.contract.test.ts app/platform/credential-protection.contract.test.ts app/services/credential-migration.contract.test.ts app/services/credential-cleanup.contract.test.ts app/services/credential-cutover-repository.contract.test.ts app/services/credential-migration-planner.contract.test.ts app/features/review/dashboard-next-action.contract.test.ts app/features/shared/development-example-workspace.contract.test.ts app/server/ai/provider-adapter.contract.test.ts app/server/ai/provider-normalization.contract.test.ts app/api/ai/generate/route.contract.test.ts app/server/ai/model-directory.contract.test.ts app/server/ai/quota-adapters.contract.test.ts app/server/import/fenbi-account-import-adapter.contract.test.ts app/server/mcp/client.contract.test.ts app/features/diagnostics/local-diagnostics.contract.test.ts app/features/onboarding/configuration-health.contract.test.ts app/features/performance/bundle-boundary.contract.test.ts app/features/settings/api-connections-settings.contract.test.ts app/features/settings/desktop-credential-migration.contract.test.ts app/features/settings/desktop-credential-migration-state.contract.test.ts app/features/settings/desktop-credential-cleanup-state.contract.test.ts app/features/settings/persona-flash-card.contract.test.ts app/features/settings/settings-architecture.contract.test.ts app/features/settings/settings-plugins.contract.test.ts app/features/study/study-registry.contract.test.ts app/services/study-module-preferences-repository.contract.test.ts app/services/ai-activity-events.contract.test.ts app/services/ai-capability-connection.contract.test.ts app/services/ai-json.contract.test.ts app/services/ai-connection-client.contract.test.ts app/services/ai-connections-repository.contract.test.ts app/services/ai-quota-plugins.contract.test.ts app/services/ai-quota-presentation.contract.test.ts app/services/ai-quota-runtime.contract.test.ts app/services/appearance-settings-repository.contract.test.ts app/services/automatic-memory-service.contract.test.ts app/services/automation.contract.test.ts app/services/automation-external-authorization.contract.test.ts app/services/canonical-conversation-context.contract.test.ts app/services/command-search.contract.test.ts app/services/conversation-repository.contract.test.ts app/services/conversation-tool-summary.contract.test.ts app/services/crypto-service.contract.test.ts app/services/declarative-extension.contract.test.ts app/services/fenbi-credential-repository.contract.test.ts app/services/import-draft-repository.contract.test.ts app/services/import-provider-plugins.contract.test.ts app/services/knowledge-evolution-service.contract.test.ts app/services/learning-context.contract.test.ts app/services/local-data-management.contract.test.ts app/services/mcp-permission.contract.test.ts app/services/mcp-settings-repository.contract.test.ts app/services/minimax-connection.contract.test.ts app/services/model-directory.contract.test.ts app/services/obsidian-knowledge.contract.test.ts app/services/personalization-settings-repository.contract.test.ts app/services/provider-contracts.contract.test.ts app/services/settings-plugin-permissions.contract.test.ts app/server/diagnostic/history/replacement.contract.test.ts app/server/diagnostic/replacement-submission.contract.test.ts",
    "test:ai-capabilities": "node --test --experimental-strip-types app/services/ai-capability-resolution.contract.test.ts app/services/ai-capability-connection.contract.test.ts app/services/ai-capability-consumers.contract.test.ts app/services/ai-connection-client.contract.test.ts app/features/conversation/conversation-message-utils.contract.test.ts app/services/provider-contracts.contract.test.ts app/server/ai/provider-adapter.contract.test.ts app/server/ai/provider-normalization.contract.test.ts app/api/ai/generate/route.contract.test.ts app/server/ai/model-directory.contract.test.ts",
    "test:quota-live": "node --test --experimental-strip-types app/server/ai/quota-live.test.ts",
    "test:gemini-live": "node --test --experimental-strip-types app/server/ai/gemini-live.test.ts",
    "test:fenbi-live": "node --test --experimental-strip-types app/server/import/fenbi-live.test.ts",
    "test:minimax-live": "node --test --experimental-strip-types app/server/ai/minimax-live.test.ts",
    "test:model-catalog-live": "node --test --experimental-strip-types app/server/ai/model-directory-live.test.ts",
    "test:e2e": "playwright test",
    "test:desktop": "npm run desktop:compile && node --test --experimental-strip-types desktop/desktop.contract.test.ts desktop/credential-storage.contract.test.ts desktop/desktop-release.contract.test.ts scripts/desktop-preload-artifact.contract.test.mjs",
    "test:desktop:installer:m3": "node --test scripts/windows-squirrel-m3-migration.contract.test.mjs",
    "test:desktop:artifact": "cross-env DESKTOP_ARTIFACT_REQUIRED=1 node --test scripts/desktop-preload-artifact.contract.test.mjs scripts/squirrel-package.contract.test.mjs",
    "test:desktop:builder:m0": "cross-env DESKTOP_BUILDER_M0_ARTIFACT_REQUIRED=1 node --test scripts/electron-builder-m0.contract.test.mjs scripts/electron-builder-m0-artifact.contract.test.mjs",
    "test:desktop:builder:nsis:source": "node --test --experimental-strip-types scripts/electron-builder-m0.contract.test.mjs scripts/electron-builder-nsis.contract.test.mjs scripts/electron-builder-nsis-ci.contract.test.mjs scripts/review-workspace-version.contract.test.mjs",
    "generate:desktop:builder:nsis:evidence": "node scripts/generate-electron-builder-nsis-evidence.mjs",
    "finalize:desktop:release-artifact": "node scripts/finalize-release-artifact.mjs",
    "verify:desktop:release-artifact": "node scripts/verify-release-artifact.mjs",
    "verify:desktop:draft-release-roundtrip": "node scripts/verify-draft-release-roundtrip.mjs",
    "test:desktop:builder:nsis:artifact": "cross-env DESKTOP_BUILDER_NSIS_ARTIFACT_REQUIRED=1 node --test scripts/electron-builder-nsis-artifact.contract.test.mjs",
    "test:desktop:builder:nsis": "npm run test:desktop:builder:nsis:source && npm run generate:desktop:builder:nsis:evidence && npm run test:desktop:builder:nsis:artifact",
    "test:desktop:integration": "npm run desktop:compile && electron desktop/preload-integration.smoke.cjs",
    "start:standalone": "node scripts/start-next-standalone.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^2.18.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "dexie": "^4.4.5",
    "geist": "1.7.2",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.16.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
